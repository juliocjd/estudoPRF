# Copie para .env ou .env.local e preencha com os dados reais.
# Esses arquivos ja estao no .gitignore.

DB_CLIENT=postgres
DATABASE_URL=postgresql://usuario:senha@host-pooler/neondb?sslmode=require&channel_binding=require

# Preferencial para migrations/importacoes administrativas no Neon.
DATABASE_DIRECT_URL=postgresql://usuario:senha@host/neondb?sslmode=require&channel_binding=require

# Opcionais
STUDY_TIME_ZONE=America/Sao_Paulo
STUDY_TIME_MAX_ATTEMPT_MINUTES=30
PGCONNECT_TIMEOUT_MS=15000
PGSTATEMENT_TIMEOUT_MS=120000
